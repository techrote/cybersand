# Stable source/archive semantics across Linux and Windows clones.
* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.py text eol=lf
*.patch text eol=lf
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hxx text eol=lf
*.inc text eol=lf
*.inl text eol=lf
*.tpp text eol=lf
*.gd text eol=lf
*.gdshader text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdextension text eol=lf
# Godot rewrites these tracked import descriptors with LF on every host.
*.import text eol=lf
*.cfg text eol=lf
*.json text eol=lf
# Retained raw campaign reports preserve their original target-host bytes.
docs/audits/play-auto002-2026-10-28/windows-campaign.json -text whitespace=cr-at-eol
docs/audits/play-auto002-2026-10-28/linux-campaign.json -text
tools/swarm45/fixtures/ui_process_q5/* -text whitespace=cr-at-eol
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Runtime libraries are required for drag-and-run checkouts but are not useful
# as ordinary Git deltas. Git LFS keeps them versioned without bloating future
# source history. The audited 05ea45f baseline remains unchanged in history.
*.so filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.dylib filter=lfs diff=lfs merge=lfs -text
*.wasm filter=lfs diff=lfs merge=lfs -text
godot/addons/godot-rapier2d/bin/*.framework/libgodot_rapier.* filter=lfs diff=lfs merge=lfs -text
godot/tools/gentek_reciprocal filter=lfs diff=lfs merge=lfs -text
godot/tools/gentek_reciprocal.exe filter=lfs diff=lfs merge=lfs -text
