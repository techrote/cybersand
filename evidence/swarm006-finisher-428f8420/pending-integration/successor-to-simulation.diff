index 000000000..54378ff45
--- /dev/null
+++ b/.github/workflows/swarm45-runtime-publication.yml
@@ -0,0 +1,73 @@
+name: SWARM-004/005 explicitly requested runtime publication
+
+on:
+  push:
+    branches: [integration/swarm004-005-mainline-20261121]
+    paths: ['.github/swarm45-runtime-publication-request.json']
+
+permissions:
+  contents: read
+concurrency:
+  group: swarm45-runtime-publication-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  publish:
+    name: Verify original qualified bytes and publish eight leased paths
+    if: github.repository == 'techrote/cybersand' && github.ref == 'refs/heads/integration/swarm004-005-mainline-20261121' && github.event_name == 'push'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    permissions:
+      contents: write
+      actions: read
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 0
+          lfs: false
+      - name: Require exact request lease and completed immutable qualification
+        id: gate
+        env:
