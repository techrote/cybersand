index 000000000..54378ff45
--- /dev/null
+++ b/.github/workflows/swarm45-runtime-publication.yml
@@ -0,0 +1,73 @@
+name: SWARM-004/005 explicitly requested runtime publication
+
+on:
+  push:
+    branches: [integration/swarm004-005-mainline-20261121]
+    paths: ['.github/swarm45-runtime-publication-request.json']
+
+permissions:
+  contents: read
+concurrency:
+  group: swarm45-runtime-publication-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  publish:
+    name: Verify original qualified bytes and publish eight leased paths
+    if: github.repository == 'techrote/cybersand' && github.ref == 'refs/heads/integration/swarm004-005-mainline-20261121' && github.event_name == 'push'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 15
+    permissions:
+      contents: write
+      actions: read
+    steps:
+      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683
+        with:
+          ref: ${{ github.sha }}
+          fetch-depth: 0
+          lfs: false
+      - name: Require exact request lease and completed immutable qualification
+        id: gate
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          set -euo pipefail
+          python3 -m unittest discover -s tools/swarm45 -p 'test_*.py' -v
+          python3 tools/ci/check_ci_provider_policy.py
+          python3 tools/swarm45/publish_runtime.py gate --output build/swarm45-publication-gate.json
+      - name: Verify artifact archive SHA-256 before extracting its nine files
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: python3 tools/swarm45/publish_runtime.py download --gate build/swarm45-publication-gate.json --output build/swarm45-publication
+      - name: Prove source equivalence and stage original runtime bytes
+        env:
+          GH_TOKEN: ${{ github.token }}
+        run: |
+          set -euo pipefail
+          git lfs install --local
+          python3 tools/swarm45/publish_runtime.py stage --bundle build/swarm45-publication --gate build/swarm45-publication-gate.json
