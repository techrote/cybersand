+	result["limit"] = cybersand_pubpres::FrameBudget::MAX_DEFERRED_TURNS;
+	result["deferred_render_step_total"] = pubpres_frame_budget.deferred_render_step_total();
+	result["consumed_render_step_total"] = pubpres_frame_budget.consumed_render_step_total();
+	result["pending_render_step"] = pubpres_frame_budget.pending_render_step();
+	result["actual_draw_submissions"] = pubpres_frame_budget.submitted();
+	result["actual_render_cpu_completions"] = pubpres_frame_budget.completed();
+	result["completion_fault"] = pubpres_frame_budget.faulted();
+	result["trace_rows"] = pubpres_frame_rows_written;
+	result["trace_capacity"] = PUBPRES_MAX_FRAME_ROWS;
+	result["trace_overflow"] = pubpres_frame_rows_overflow;
+	result["sync_calls"] = pubpres_sync_calls;
+	result["sync_total_usec"] = pubpres_sync_total_usec;
+	result["sync_max_usec"] = pubpres_sync_max_usec;
+	result["scope"] = "whole_process_actual_draw_cpu_only_no_gpu_fence_no_scanout_no_physics_credit";
+	Array rows;
+	const uint64_t count = MIN(pubpres_frame_rows_written, uint64_t(PUBPRES_MAX_FRAME_ROWS));
+	for (uint64_t index = 0; pubpres_frame_rows_data && index < count; ++index) {
+		const PubpresFrameRow &row = pubpres_frame_rows_data[index];
+		Dictionary entry;
+		entry["serial"] = row.serial;
+		entry["process_frame"] = row.process_frame;
+		entry["submitted_usec"] = row.submitted_usec;
+		entry["render_start_usec"] = row.render_start_usec;
+		entry["render_end_usec"] = row.render_end_usec;
+		entry["previous_batch_deferred_turns"] = row.previous_batch_deferred_turns;
+		entry["applied_render_step"] = row.applied_render_step;
+		entry["carried_render_step"] = row.carried_render_step;
+		entry["actual_render_owner"] = row.actual_render_owner;
+		entry["inline_main"] = row.inline_main;
+		rows.push_back(entry);
+	}
+	Dictionary evidence = result.duplicate(true);
+	evidence["frames"] = rows;
+	Error file_error = ERR_INVALID_PARAMETER;
+	if (!pubpres_budget_trace_path.is_empty()) {
+		Ref<FileAccess> file = FileAccess::open(pubpres_budget_trace_path, FileAccess::WRITE, &file_error);
+		if (file.is_valid()) {
+			file->store_string(JSON::stringify(evidence, "\t", true, true) + "\n");
+			file->flush();
+			file_error = file->get_error();
+			file.unref();
+		}
+	}
+	result["trace_write_error"] = int(file_error);
+	result["trace_sha256"] = file_error == OK ? FileAccess::get_sha256(pubpres_budget_trace_path) : String();
+	print_line("PUBPRES_FRAME_BUDGET_RESULT " + JSON::stringify(result));
