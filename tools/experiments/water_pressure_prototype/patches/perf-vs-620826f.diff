+namespace detail {
+// Derived, never authored: one 256-bit partner set per material lets the
+// production resolver reject non-reacting neighbours without scanning every
+// rule. Namespace-scope storage matters: a function-local constexpr array is an
+// automatic object, which some compilers rebuild on the stack per call.
+using PairPartnerSet = std::array<std::uint64_t, 4>;
+[[nodiscard]] constexpr std::array<PairPartnerSet, 256> build_pair_partner_sets() noexcept {
+    std::array<PairPartnerSet, 256> sets{};
+    for (const auto& rule : kPairInteractionRules) {
+        const auto a = static_cast<std::uint8_t>(rule.first);
+        const auto b = static_cast<std::uint8_t>(rule.second);
+        sets[a][b >> 6U] |= std::uint64_t{1} << (b & 63U);
+        if (rule.match != InteractionMatchKind::Ordered) {
+            sets[b][a >> 6U] |= std::uint64_t{1} << (a & 63U);
+        }
+    }
+    return sets;
+}
+[[nodiscard]] constexpr std::array<bool, 256> build_pair_participants() noexcept {
+    std::array<bool, 256> participants{};
+    for (const auto& rule : kPairInteractionRules) {
+        participants[static_cast<std::uint8_t>(rule.first)] = true;
+        participants[static_cast<std::uint8_t>(rule.second)] = true;
+    }
+    return participants;
+}
+inline constexpr auto kPairPartnerSets = build_pair_partner_sets();
+inline constexpr auto kPairParticipants = build_pair_participants();
