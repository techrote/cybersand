+    // Globally unique identity of one chunk-map state. Every insert/clear and
+    // every move of the owning World takes a fresh value, so a per-thread
+    // last-chunk lookup cache keyed on it can never return a stale pointer.
+    class ChunkMapIdentity final {
+    public:
+        ChunkMapIdentity() noexcept : value_(fresh()) {}
+        ChunkMapIdentity(const ChunkMapIdentity&) = delete;
+        ChunkMapIdentity& operator=(const ChunkMapIdentity&) = delete;
+        ChunkMapIdentity(ChunkMapIdentity&& other) noexcept : value_(fresh()) {
+            other.value_ = fresh();
+        }
+        ChunkMapIdentity& operator=(ChunkMapIdentity&& other) noexcept {
+            value_ = fresh();
+            other.value_ = fresh();
+            return *this;
+        }
+        void renew() noexcept { value_ = fresh(); }
+        [[nodiscard]] std::uint64_t value() const noexcept { return value_; }
+
+    private:
+        static std::uint64_t fresh() noexcept;
+        std::uint64_t value_;
+    };
