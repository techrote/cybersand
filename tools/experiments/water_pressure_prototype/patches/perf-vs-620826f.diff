 const World::Chunk* World::find_chunk(ChunkCoord coord) const noexcept {
+    // Rule kernels probe neighbours that are almost always in the chunk they
+    // last touched. Each thread remembers one lookup, keyed on the globally
+    // unique map identity, so a hit skips hashing and bucket traversal. Misses
+    // (including absent chunks) are cached too; any insert renews the identity.
+    struct LastLookup {
+        std::uint64_t identity = 0;
+        ChunkCoord coord{};
+        const Chunk* chunk = nullptr;
+    };
+    thread_local LastLookup last{};
+    const auto identity = chunk_map_identity_.value();
+    if (last.identity == identity && last.coord == coord) return last.chunk;
     const auto found = chunks_.find(coord);
-    return found == chunks_.end() ? nullptr : found->second.get();
+    const Chunk* chunk = found == chunks_.end() ? nullptr : found->second.get();
+    last = {identity, coord, chunk};
+    return chunk;
+}
