{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CyberSand Atlas API agent run receipt",
  "description": "Stable contract for #500 automation. 'estimated' (reserved worst case) and 'computed from reported usage' costs are distinct; neither is a bill. Credentials never appear.",
  "type": "object",
  "required": ["schema", "receipt_sha256", "run", "status", "source", "policy", "model", "limits", "usage", "cost",
               "credit_gate", "calls", "tools", "validation", "edits", "images", "captures", "visual_cycle",
               "final_report", "artifacts", "publication"],
  "properties": {
    "schema": {"const": "cybersand.atlas-agent.receipt/1"},
    "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run": {
      "type": "object",
      "required": ["id", "started_utc", "finished_utc", "duration_seconds", "mode", "runner_version",
                   "model_calls_simulated"],
      "properties": {
        "id": {"type": "string", "minLength": 4},
        "mode": {"enum": ["dry-run", "live"]},
        "model_calls_simulated": {"type": "boolean"},
        "duration_seconds": {"type": "number", "minimum": 0}
      }
    },
    "status": {
      "type": "object",
      "required": ["final", "exit_code", "reason_code", "reason", "phase"],
      "properties": {
        "final": {"enum": ["success", "failure", "stopped"]},
        "exit_code": {"type": "integer", "minimum": 0, "maximum": 9},
        "reason_code": {"type": "string", "minLength": 2},
        "phase": {"enum": ["preflight", "gate", "loop", "finalise", "done"]}
      }
    },
    "source": {
      "type": "object",
      "required": ["repository_head", "expected_source_sha", "source_dirty", "source_manifest_sha256", "collection",
                   "lane", "lane_writable", "fixture", "files", "head_after_run", "source_unchanged_after_run"],
      "properties": {
        "collection": {"type": "string"},
        "lane": {"type": ["string", "null"]},
        "lane_writable": {"type": "boolean"},
        "fixture": {"type": "boolean"},
        "files": {"type": "object", "additionalProperties": {
          "type": "object", "required": ["sha256", "bytes"],
          "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer"}}}}
      }
    },
    "policy": {
      "type": "object",
      "required": ["instructions_version", "instructions_sha256", "tool_schema_sha256", "pricing_sha256", "read_globs",
                   "write_globs", "tools_advertised"],
      "properties": {
        "read_globs": {"type": "array", "items": {"type": "string"}},
        "write_globs": {"type": "array", "items": {"type": "string"}},
        "tools_advertised": {"type": "array", "items": {"type": "string"}}
      }
    },
    "model": {
      "type": "object",
      "required": ["requested", "observed", "reasoning_effort", "max_output_tokens_per_call", "image_detail",
                   "api_endpoint", "store", "truncation"],
      "properties": {
        "requested": {"type": "string"},
        "observed": {"type": "array", "items": {"type": "string"}},
        "api_endpoint": {"enum": ["none", "openai-default", "loopback-test"]},
        "store": {"const": false}
      }
    },
    "limits": {"type": "object"},
    "usage": {
      "type": "object",
      "required": ["api_attempts", "api_responses", "retries", "iterations", "tool_calls", "malformed_tool_calls",
                   "sandbox_violations", "images_loaded", "image_sends", "image_bytes", "input_tokens",
                   "cached_input_tokens", "output_tokens", "reasoning_tokens", "tool_seconds"],
      "properties": {
        "api_attempts": {"type": "integer", "minimum": 0},
        "api_responses": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "cost": {
      "type": "object",
      "required": ["currency", "basis", "rates", "reserved_worst_case_total_usd", "peak_reservation_usd",
                   "computed_from_reported_usage_usd", "ambiguous_charge_assumed_usd", "committed_usd",
                   "per_call_ceiling_usd", "per_run_ceiling_usd", "authorised_ceiling_usd", "remaining_allowance_usd",
                   "billing_reconciliation", "simulated"],
      "properties": {
        "currency": {"const": "USD"},
        "committed_usd": {"type": "number", "minimum": 0},
        "simulated": {"type": "boolean"}
      }
    },
    "credit_gate": {
      "type": "object",
      "required": ["performed", "passed", "checks", "headroom_basis", "facts"],
      "properties": {
        "checks": {"type": "array", "items": {"type": "object", "required": ["name", "ok", "detail"],
                                              "properties": {"name": {"type": "string"}, "ok": {"type": "boolean"}}}}
      }
    },
    "calls": {"type": "array", "items": {"type": "object", "required": ["n", "kind"]}},
    "tools": {"type": "array", "items": {"type": "object", "required": ["n", "name", "args_sha256", "ok"]}},
    "validation": {"type": "array", "items": {"type": "object", "required": ["n", "kind", "exit_code", "passed"]}},
    "edits": {"type": "array", "items": {"type": "object", "required": ["path", "before_sha256", "after_sha256"]}},
    "images": {"type": "array", "items": {"type": "object", "required": ["sha256", "bytes", "evidence_class"]}},
    "captures": {"type": "object", "required": ["input_bundle", "rendered_bundle", "comparison", "render_attempts"]},
    "visual_cycle": {"type": "object", "required": ["claimed", "reason"],
                     "properties": {"claimed": {"type": "boolean"}}},
    "final_report": {"type": ["object", "null"]},
    "artifacts": {"type": "object", "required": ["patch", "tool_log", "transcript"]},
    "publication": {"type": "object", "required": ["mode", "performed"],
                    "properties": {"mode": {"const": "none"}, "performed": {"const": false}}}
  }
}
