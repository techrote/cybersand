+void RenderingServerDefault::_pubpres_write_evidence() {
+	Dictionary result;
+	result["schema"] = "pubpres-engine-frame-budget-v2";
+	result["application_source_revision"] = pubpres_application_source;
+	result["application_admission_faults"] = pubpres_admission_faults;
+	result["rejected_draw_opportunities"] = pubpres_admission_clock.rejections();
+	result["rejected_render_step_total"] = pubpres_admission_clock.rejected_steps();
+	result["consumed_rejected_render_step"] = pubpres_admission_clock.consumed_steps();
+	result["pending_rejected_render_step"] = pubpres_admission_clock.pending();
+	result["requested"] = pubpres_budget_requested;
+	result["render_thread_created"] = create_thread;
+	result["eligibility_checks"] = pubpres_eligibility_checks;
+	result["eligible_checks"] = pubpres_eligible_checks;
+	result["deferred_turns"] = pubpres_frame_budget.deferrals();
+	result["maximum_deferred_per_draw"] = pubpres_frame_budget.max_budget_spent();
+	result["limit"] = cybersand_pubpres::FrameBudget::MAX_DEFERRED_TURNS;
+	result["deferred_render_step_total"] = pubpres_frame_budget.deferred_render_step_total();
+	result["consumed_render_step_total"] = pubpres_frame_budget.consumed_render_step_total();
+	result["pending_render_step"] = pubpres_frame_budget.pending_render_step();
+	result["actual_draw_submissions"] = pubpres_frame_budget.submitted();
+	result["actual_render_cpu_completions"] = pubpres_frame_budget.completed();
