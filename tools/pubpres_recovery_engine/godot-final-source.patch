+bool RenderingServerDefault::_pubpres_get_handshake(Dictionary &r_handshake, Object *&r_owner) {
+	if (!has_meta(SNAME("cybersand_actual_submission_v1"))) {
+		return false;
+	}
+	const Variant submission_metadata = get_meta(SNAME("cybersand_actual_submission_v1"), Variant());
+	if (submission_metadata.get_type() != Variant::DICTIONARY) {
+		return false;
+	}
+	r_handshake = submission_metadata;
+	const Variant schema = r_handshake.get("schema", Variant());
+	const Variant enabled = r_handshake.get("enabled", Variant());
+	const Variant connected = r_handshake.get("connected", Variant());
+	const Variant ready = r_handshake.get("candidate_ready", Variant());
+	const Variant owner_id = r_handshake.get("owner_instance", Variant());
+	const Variant source = r_handshake.get("source_revision", Variant());
+	const Variant process_frame = r_handshake.get("process_frame", Variant());
+	bool valid = schema.get_type() == Variant::STRING && String(schema) == "pubpres-actual-submission-v1" &&
+			enabled.get_type() == Variant::BOOL && bool(enabled) &&
+			connected.get_type() == Variant::BOOL && bool(connected) &&
+			ready.get_type() == Variant::BOOL && bool(ready) &&
+			owner_id.get_type() == Variant::INT && int64_t(owner_id) != 0 &&
+			source.get_type() == Variant::STRING &&
+			process_frame.get_type() == Variant::INT && int64_t(process_frame) >= 0 &&
+			uint64_t(int64_t(process_frame)) == Engine::get_singleton()->get_process_frames();
+	if (!valid) {
+		return false;
+	}
+	const String revision = source;
+	valid = revision.length() == 40;
+	for (int index = 0; valid && index < revision.length(); ++index) {
+		const char32_t character = revision[index];
+		valid = (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f');
+	}
+	r_owner = ObjectDB::get_instance(ObjectID(uint64_t(int64_t(owner_id))));
+	return valid && r_owner != nullptr &&
+			r_owner->has_method(SNAME("_commit_workbench_presentation_submission")) &&
+			is_connected(SNAME("frame_pre_draw"), Callable(r_owner, SNAME("_commit_workbench_presentation_submission")));
+}
+
+bool RenderingServerDefault::pubpres_defer_main_draw(bool p_allowed, double p_render_step) {
+	if (!pubpres_budget_track || !Thread::is_main_thread()) {
+		return false;
+	}
+	++pubpres_eligibility_checks;
+	Dictionary handshake;
+	Object *owner = nullptr;
+	const bool eligible = p_allowed && create_thread && !pubpres_interpolation_enabled &&
+			!pubpres_profile_enabled && !print_gpu_profile &&
+			RenderingDevice::get_singleton() == nullptr && server_thread != Thread::MAIN_ID &&
+			_pubpres_get_handshake(handshake, owner);
+	if (eligible) {
+		++pubpres_eligible_checks;
+	}
+	return pubpres_frame_budget.defer_if_pending(pubpres_budget_requested == "4" && eligible, p_render_step);
+}
+
+bool RenderingServerDefault::_pubpres_application_admission(PubpresApplicationReceipt &r_receipt) {
+	if (!has_meta(SNAME("cybersand_actual_submission_v1"))) {
+		return true;
+	}
+	const Variant submission_metadata = get_meta(SNAME("cybersand_actual_submission_v1"), Variant());
+	if (submission_metadata.get_type() == Variant::NIL) {
+		return true; // Ordinary applications have not selected this contract.
+	}
+	if (submission_metadata.get_type() == Variant::DICTIONARY) {
+		const Dictionary state = submission_metadata;
+		const Variant enabled = state.get("enabled", Variant());
+		if (enabled.get_type() == Variant::BOOL && !bool(enabled)) {
+			return true;
+		}
+	}
+	// A deferred manual draw may follow the application's marker while later
+	// nested canvas callbacks are still queued. Only the completed Main flush
+	// establishes that every staged command has reached the rendering queue.
+	if (MessageQueue::get_main_singleton()->is_flushing()) {
+		return false;
+	}
+	Dictionary handshake;
+	Object *owner = nullptr;
+	if (!_pubpres_get_handshake(handshake, owner)) {
+		return false;
+	}
+	// Capture identities before invoking trusted application code. That callback
+	// validates an immutable, already-flushed candidate before any journal write.
+	// It constructs the complete typed receipt first, commits without callbacks,
+	// and cannot refuse after committing. Signal observers run only after this
+	// receipt is admitted below. A refusal suppresses the ENTIRE actual draw.
+	const int64_t expected_owner = int64_t(handshake["owner_instance"]);
+	const int64_t expected_frame = int64_t(handshake["process_frame"]);
+	const String expected_source = handshake["source_revision"];
+	const Variant returned = owner->call(SNAME("_commit_workbench_presentation_submission"), true);
+	if (returned.get_type() != Variant::DICTIONARY) {
+		++pubpres_admission_faults;
+		return false;
+	}
+	const Dictionary receipt = returned;
+	const Variant accepted = receipt.get("accepted", Variant());
+	if (accepted.get_type() != Variant::BOOL || !bool(accepted)) {
+		return false;
+	}
+	const Variant owner_id = receipt.get("owner_instance", Variant());
+	const Variant submission = receipt.get("submission_serial", Variant());
+	const Variant candidate = receipt.get("candidate_serial", Variant());
+	const Variant frame = receipt.get("process_frame", Variant());
+	const Variant submitted = receipt.get("submitted_usec", Variant());
+	const Variant source = receipt.get("source_revision", Variant());
+	const bool valid = owner_id.get_type() == Variant::INT && int64_t(owner_id) == expected_owner &&
+			submission.get_type() == Variant::INT && int64_t(submission) > 0 &&
+			candidate.get_type() == Variant::INT && int64_t(candidate) > 0 &&
+			frame.get_type() == Variant::INT && int64_t(frame) == expected_frame &&
+			submitted.get_type() == Variant::INT && int64_t(submitted) > 0 &&
+			uint64_t(int64_t(submitted)) <= OS::get_singleton()->get_ticks_usec() &&
+			source.get_type() == Variant::STRING && String(source) == expected_source &&
+			(pubpres_last_application_receipt.owner_instance != expected_owner ||
+					(uint64_t(int64_t(submission)) > pubpres_last_application_receipt.submission_serial &&
+							uint64_t(int64_t(candidate)) > pubpres_last_application_receipt.candidate_serial));
+	if (!valid) {
+		++pubpres_admission_faults;
+		return false;
+	}
+	r_receipt.owner_instance = expected_owner;
+	r_receipt.submission_serial = uint64_t(int64_t(submission));
+	r_receipt.candidate_serial = uint64_t(int64_t(candidate));
+	r_receipt.submitted_usec = uint64_t(int64_t(submitted));
+	pubpres_last_application_receipt = r_receipt;
+	pubpres_application_source = expected_source;
+	return true;
+}
+
+void RenderingServerDefault::_pubpres_draw(bool p_present, double p_step, uint64_t p_serial,
+		uint64_t p_submitted_usec, uint64_t p_process_frame, uint32_t p_deferred_turns, double p_carried_step,
+		double p_rejected_step, PubpresApplicationReceipt p_application) {
+	const uint64_t started = OS::get_singleton()->get_ticks_usec();
+	// Exactly one real draw. Its returned CPU work is not a GPU fence and does
+	// not grant a Rapier step or a scanout/pixel visibility claim.
+	_draw(p_present, p_step);
+	const uint64_t ended = OS::get_singleton()->get_ticks_usec();
+	if (pubpres_frame_rows_data && pubpres_frame_rows_written < PUBPRES_MAX_FRAME_ROWS) {
+		PubpresFrameRow &row = pubpres_frame_rows_data[pubpres_frame_rows_written];
+		row.serial = p_serial;
+		row.process_frame = p_process_frame;
+		row.submitted_usec = p_submitted_usec;
+		row.render_start_usec = started;
+		row.render_end_usec = ended;
+		row.previous_batch_deferred_turns = p_deferred_turns;
+		row.applied_render_step = p_step;
+		row.carried_render_step = p_carried_step;
+		row.rejected_render_step = p_rejected_step;
+		row.application = p_application;
+		row.actual_render_owner = create_thread && Thread::get_caller_id() == server_thread;
+		row.inline_main = !create_thread && Thread::is_main_thread();
+	} else {
+		pubpres_frame_rows_overflow = true;
+	}
+	++pubpres_frame_rows_written;
+	// This release publication follows all actual draw work and trace writes.
+	// Main still executes the original queue barrier before a following draw.
+	pubpres_frame_budget.complete_draw(p_serial);
+}
