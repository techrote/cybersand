+bool RenderingServerDefault::_pubpres_application_admission(PubpresApplicationReceipt &r_receipt) {
+	if (!has_meta(SNAME("cybersand_actual_submission_v1"))) {
+		return true;
+	}
+	const Variant submission_metadata = get_meta(SNAME("cybersand_actual_submission_v1"), Variant());
+	if (submission_metadata.get_type() == Variant::NIL) {
+		return true; // Ordinary applications have not selected this contract.
+	}
+	if (submission_metadata.get_type() == Variant::DICTIONARY) {
+		const Dictionary state = submission_metadata;
+		const Variant enabled = state.get("enabled", Variant());
+		if (enabled.get_type() == Variant::BOOL && !bool(enabled)) {
+			return true;
+		}
+	}
+	// A deferred manual draw may follow the application's marker while later
+	// nested canvas callbacks are still queued. Only the completed Main flush
+	// establishes that every staged command has reached the rendering queue.
+	if (MessageQueue::get_main_singleton()->is_flushing()) {
+		return false;
+	}
+	Dictionary handshake;
+	Object *owner = nullptr;
+	if (!_pubpres_get_handshake(handshake, owner)) {
+		return false;
+	}
+	// Capture identities before invoking trusted application code. That callback
+	// validates an immutable, already-flushed candidate before any journal write.
+	// It constructs the complete typed receipt first, commits without callbacks,
+	// and cannot refuse after committing. Signal observers run only after this
+	// receipt is admitted below. A refusal suppresses the ENTIRE actual draw.
+	const int64_t expected_owner = int64_t(handshake["owner_instance"]);
+	const int64_t expected_frame = int64_t(handshake["process_frame"]);
+	const String expected_source = handshake["source_revision"];
+	const Variant returned = owner->call(SNAME("_commit_workbench_presentation_submission"), true);
+	if (returned.get_type() != Variant::DICTIONARY) {
+		++pubpres_admission_faults;
+		return false;
+	}
+	const Dictionary receipt = returned;
+	const Variant accepted = receipt.get("accepted", Variant());
+	if (accepted.get_type() != Variant::BOOL || !bool(accepted)) {
+		return false;
+	}
+	const Variant owner_id = receipt.get("owner_instance", Variant());
+	const Variant submission = receipt.get("submission_serial", Variant());
+	const Variant candidate = receipt.get("candidate_serial", Variant());
+	const Variant frame = receipt.get("process_frame", Variant());
+	const Variant submitted = receipt.get("submitted_usec", Variant());
+	const Variant source = receipt.get("source_revision", Variant());
+	const bool valid = owner_id.get_type() == Variant::INT && int64_t(owner_id) == expected_owner &&
+			submission.get_type() == Variant::INT && int64_t(submission) > 0 &&
+			candidate.get_type() == Variant::INT && int64_t(candidate) > 0 &&
+			frame.get_type() == Variant::INT && int64_t(frame) == expected_frame &&
+			submitted.get_type() == Variant::INT && int64_t(submitted) > 0 &&
+			uint64_t(int64_t(submitted)) <= OS::get_singleton()->get_ticks_usec() &&
+			source.get_type() == Variant::STRING && String(source) == expected_source &&
+			(pubpres_last_application_receipt.owner_instance != expected_owner ||
+					(uint64_t(int64_t(submission)) > pubpres_last_application_receipt.submission_serial &&
+							uint64_t(int64_t(candidate)) > pubpres_last_application_receipt.candidate_serial));
+	if (!valid) {
+		++pubpres_admission_faults;
+		return false;
+	}
+	r_receipt.owner_instance = expected_owner;
+	r_receipt.submission_serial = uint64_t(int64_t(submission));
+	r_receipt.candidate_serial = uint64_t(int64_t(candidate));
+	r_receipt.submitted_usec = uint64_t(int64_t(submitted));
+	pubpres_last_application_receipt = r_receipt;
+	pubpres_application_source = expected_source;
+	return true;
+}
