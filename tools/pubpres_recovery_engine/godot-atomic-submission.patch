+bool RenderingServerDefault::_pubpres_get_handshake(Dictionary &r_handshake, Object *&r_owner) {
+	if (!has_meta(SNAME("cybersand_actual_submission_v1"))) {
+		return false;
+	}
+	const Variant submission_metadata = get_meta(SNAME("cybersand_actual_submission_v1"), Variant());
+	if (submission_metadata.get_type() != Variant::DICTIONARY) {
+		return false;
+	}
+	r_handshake = submission_metadata;
+	const Variant schema = r_handshake.get("schema", Variant());
+	const Variant enabled = r_handshake.get("enabled", Variant());
+	const Variant connected = r_handshake.get("connected", Variant());
+	const Variant ready = r_handshake.get("candidate_ready", Variant());
+	const Variant owner_id = r_handshake.get("owner_instance", Variant());
+	const Variant source = r_handshake.get("source_revision", Variant());
+	const Variant process_frame = r_handshake.get("process_frame", Variant());
+	bool valid = schema.get_type() == Variant::STRING && String(schema) == "pubpres-actual-submission-v1" &&
+			enabled.get_type() == Variant::BOOL && bool(enabled) &&
+			connected.get_type() == Variant::BOOL && bool(connected) &&
+			ready.get_type() == Variant::BOOL && bool(ready) &&
+			owner_id.get_type() == Variant::INT && int64_t(owner_id) != 0 &&
+			source.get_type() == Variant::STRING &&
+			process_frame.get_type() == Variant::INT && int64_t(process_frame) >= 0 &&
+			uint64_t(int64_t(process_frame)) == Engine::get_singleton()->get_process_frames();
+	if (!valid) {
+		return false;
+	}
+	const String revision = source;
+	valid = revision.length() == 40;
+	for (int index = 0; valid && index < revision.length(); ++index) {
+		const char32_t character = revision[index];
+		valid = (character >= '0' && character <= '9') || (character >= 'a' && character <= 'f');
+	}
+	r_owner = ObjectDB::get_instance(ObjectID(uint64_t(int64_t(owner_id))));
+	return valid && r_owner != nullptr &&
+			r_owner->has_method(SNAME("_commit_workbench_presentation_submission")) &&
+			is_connected(SNAME("frame_pre_draw"), Callable(r_owner, SNAME("_commit_workbench_presentation_submission")));
+}
