{
  "name": "CyberSand remote workbench",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/start-sshd.sh && bash .devcontainer/post-create.sh",
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "CyberSand authenticated workbench",
      "onAutoForward": "silent",
      "visibility": "private"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  },
  "containerEnv": {
    "SCONS_JOBS": "2"
  },
  "shutdownAction": "stopContainer",
  "postStartCommand": "bash .devcontainer/start-sshd.sh"
}
