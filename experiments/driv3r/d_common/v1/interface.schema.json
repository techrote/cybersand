          ]
        },
        "outcome": {
          "enum": [
            "success",
            "stop",
            "budget_exhausted",
            "invalid_decision",
            "model_failure",
            "native_refusal",
            "cancelled",
            "partial",
            "research_failed"
          ]
        },
        "metrics": {
          "type": "object",
          "description": "Host-computed, non-authoritative for permissions. Metric keys and units must be declared in the experiment manifest.",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            ]
          }
        },
        "replay": {
          "enum": [
            "not_attempted",
            "pass",
            "fail"
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blob"
          }
        }
      }
    }
  }
}
