        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "episode_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
