{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/techrote/cybersand/experiments/driv3r/d_common/v1/interface.schema.json",
  "title": "CyberSand DRIV3R D-COMMON-001 versioned interface contract candidate",
  "description": "Five strict, discriminated wire records. Semantic/cross-record guards in README.md are mandatory in addition to JSON Schema.",
  "oneOf": [
    {
      "$ref": "#/$defs/observation"
    },
    {
      "$ref": "#/$defs/guidance"
    },
    {
      "$ref": "#/$defs/action"
    },
    {
      "$ref": "#/$defs/reversal"
    },
    {
      "$ref": "#/$defs/provenance"
    }
  ],
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "rect": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        }
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "blob": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes",
        "format"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)(?!.*//)[A-Za-z0-9_./-]+$",
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "format": {
          "enum": [
            "u16le",
            "i32le",
            "png",
            "jsonl",
            "json",
            "csv",
            "bin"
          ]
        }
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "generation",
        "revision",
        "tick",
        "material_sha256",
        "world_material_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "material_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "world_material_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "type",
        "record_id",
        "episode_id",
        "sequence",
        "objective",
        "subgoal",
        "world",
        "cursor",
        "target",
        "guidance_ref",
        "last_action_ref",
        "last_native_receipt_ref",
        "local_material",
        "local_crop",
        "host_geometry",
        "history_sha256",
        "rules",
        "budget",
        "feedback_views"
      ],
      "properties": {
        "protocol": {
          "const": "cybersand.driv3r.d-common/1"
        },
        "type": {
          "const": "observation"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "episode_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "subgoal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "world": {
          "$ref": "#/$defs/world"
        },
        "cursor": {
          "$ref": "#/$defs/point"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "guidance_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_action_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_native_receipt_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "local_material": {
          "$ref": "#/$defs/blob"
        },
        "local_crop": {
          "$ref": "#/$defs/rect"
        },
        "host_geometry": {
          "type": "object",
          "description": "Host-computed, non-authoritative for permissions. Metric keys and units must be declared in the experiment manifest.",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            ]
          }
        },
        "history_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "focus",
            "allowed_materials",
            "forbidden_materials",
            "protected_rectangles"
          ],
          "properties": {
            "focus": {
              "$ref": "#/$defs/rect"
            },
            "allowed_materials": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "uniqueItems": true
            },
            "forbidden_materials": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 255
              },
              "uniqueItems": true
            },
            "protected_rectangles": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/rect"
              },
              "maxItems": 64
            }
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decisions_remaining",
            "material_cell_budget",
            "wall_seconds_remaining"
          ],
          "properties": {
            "decisions_remaining": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "material_cell_budget": {
              "type": "integer",
              "minimum": 0
            },
            "wall_seconds_remaining": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "feedback_views": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "artifact",
              "source_world"
            ],
            "properties": {
              "role": {
                "enum": [
                  "before_material",
                  "after_material",
                  "before_framebuffer",
                  "after_framebuffer",
                  "guidance_overlay"
                ]
              },
              "artifact": {
                "$ref": "#/$defs/blob"
              },
              "source_world": {
                "$ref": "#/$defs/world"
              }
            }
          },
          "maxItems": 8
        }
      }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "type",
        "record_id",
        "episode_id",
        "sequence",
        "label",
        "frame",
        "source_kind",
        "purpose",
        "values",
        "display",
        "encoding",
        "speckle",
        "hysteresis",
        "native_material_authority",
        "authoring_seed"
      ],
      "properties": {
        "protocol": {
          "const": "cybersand.driv3r.d-common/1"
        },
        "type": {
          "const": "guidance"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "episode_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "frame": {
          "$ref": "#/$defs/rect"
        },
        "source_kind": {
          "enum": [
            "airbrush",
            "imported_png",
            "procedural",
            "composite",
            "manual_scalar"
          ]
        },
        "purpose": {
          "const": "soft_positive_preference"
        },
        "values": {
          "$ref": "#/$defs/blob"
        },
        "display": {
          "anyOf": [
            {
              "$ref": "#/$defs/blob"
            },
            {
              "type": "null"
            }
          ]
        },
        "encoding": {
          "const": "u16le_higher_is_better_zero_is_neutral"
        },
        "speckle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seed",
            "radius_cells",
            "centre_density",
            "hardness",
            "gradient_length"
          ],
          "properties": {
            "seed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "radius_cells": {
              "type": "integer",
              "minimum": 1,
              "maximum": 512
            },
            "centre_density": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hardness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "gradient_length": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "hysteresis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "exit_below",
            "reenter_at_or_above"
          ],
          "properties": {
            "exit_below": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            },
            "reenter_at_or_above": {
              "type": "integer",
              "minimum": 0,
              "maximum": 65535
            }
          }
        },
        "native_material_authority": {
          "const": false
        },
        "authoring_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "type",
        "record_id",
        "episode_id",
        "sequence",
        "observation_ref",
        "world_precondition",
        "candidate_set_sha256",
        "candidate_id",
        "actor",
        "mode",
        "cursor_before",
        "cursor_after",
        "path",
        "brush_state",
        "guidance_ref",
        "operation_sha256",
        "model_decision_ref",
        "predicted_effects",
        "execution_status",
        "native_receipt_ref"
      ],
      "properties": {
        "protocol": {
          "const": "cybersand.driv3r.d-common/1"
        },
        "type": {
          "const": "action"
        },
        "record_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "episode_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "observation_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "world_precondition": {
          "$ref": "#/$defs/world"
        },
        "candidate_set_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
        },
        "actor": {
          "enum": [
            "d1",
            "deterministic",
            "random_legal",
            "human",
            "other_model"
          ]
        },
        "mode": {
          "enum": [
            "cursor_move",
            "procedural_segment",
            "add_material",
            "erase_material",
            "no_paint_plan",
            "stop"
          ]
        },
        "cursor_before": {
          "$ref": "#/$defs/point"
        },
        "cursor_after": {
          "$ref": "#/$defs/point"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "maxItems": 100000
        },
        "brush_state": {
          "enum": [
            "up",
            "add",
            "erase"
          ]
        },
        "guidance_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_decision_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "predicted_effects": {
          "type": "object",
          "description": "Host-computed, non-authoritative for permissions. Metric keys and units must be declared in the experiment manifest.",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "number"
                }
              }
            ]
          }
        },
        "execution_status": {
          "enum": [
            "candidate",
            "selected",
            "submitted",
            "committed",
            "refused",
            "cancelled",
            "partial"
          ]
        },
        "native_receipt_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
