        "after_world": {
          "anyOf": [
            {
              "$ref": "#/$defs/world"
            },
            {
              "type": "null"
            }
          ]
        },
        "native_undo_receipt_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,95}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "actual_material_cells_changed": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "proposed",
            "applied",
            "refused",
            "cancelled"
          ]
        },
        "reason_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "type",
        "record_id",
        "episode_id",
        "sequence",
        "source_commit",
        "source_tree",
        "base_commit",
        "interface_schema_sha256",
        "experiment_id",
        "arm",
        "split",
        "scenario_sha256",
        "algorithm",
        "model",
        "native",
        "guidance_ref",
        "episode_record_refs",
        "final_world",
        "outcome",
        "metrics",
        "replay",
        "artifacts"
      ],
