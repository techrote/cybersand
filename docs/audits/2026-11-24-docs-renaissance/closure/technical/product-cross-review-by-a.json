  "findings": [
    {
      "id": "CA-B-01",
      "priority": "P1",
      "status": "resolved-in-reviewed-text",
      "finding": "Source distinguishes the launcher checks from repository source-input provenance. The wrapper compares exact Godot and native DLL hash and reports checkout/runtime identity; it does not iterate the provenance source_inputs. The separate checker does. Corrected procedure names that separate check without claiming a new launch."
    },
    {
      "id": "CA-B-02",
      "priority": "P1",
      "status": "resolved-in-reviewed-text",
      "finding": "Generated Load opens source verification and starts a preview. _complete checks every saved provenance key, reaches ready, and enables the confirmation button; only confirmed->_install calls install_generated_start. The added Install into workbench step repairs a real incomplete reopening instruction. Source mismatch refuses before installation and cancellation retains the installed map."
    },
    {
      "id": "CA-B-03",
      "priority": "P1",
      "status": "resolved-in-reviewed-text",
      "finding": "Setup name grammar is exactly 1\u201348 characters from ASCII a-z/A-Z/0-9/-/_. Named saves replace their destination; source has no separate overwrite-confirmation UI. The new-name recommendation prevents accidental replacement without claiming a versioned save system."
    },
    {
      "id": "CA-B-04",
      "priority": "P2",
      "status": "resolved-in-reviewed-text",
      "finding": "model_context uses conversation.size()-12 for Compacted and Custom, so the count is messages, including user native-feedback entries, not request-response cycles. The extra latest-result message is appended only when first>0. Corrected prose captures both conditions."
    }
  ],
