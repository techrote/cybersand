  "decisions": {
    "impact": "For mass/scale/orientation/anchor arms with B0 entry>1px, at least 75% must reduce peak entry by >=20%, with no arm worse by >max(.5px,10% of B0); pre/post overlap must not systematically worsen. All individual exceptions retained.",
    "credible_rest": {
      "window": "final300 synchronous samples of static deep/anchor/mass/scale/orientation/material/historical cases; rest only after observed support",
