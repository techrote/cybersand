    "rebound": {
      "peak_upward_speed": 15.0,
      "new_repeated_bounce": "three or more >1px up/down excursions after first arrest",
      "unsupported_hover": "30 consecutive frames |vy|<.5 above material without current support",
      "long_cycle": "new repeated >1px vertical excursions in final300"
    },
    "release": "Full bed removal at sample600: current bearing/support retire at first accepted post-edit sample; fall >=4px in60 samples. Partial edits report residual valid support and re-bearing separately; no correction without support.",
    "lateral": "Travel Y1>=75% B0 over same controlled interval unless Rapier hard wall intervenes. Report any new >30frame unsupported hover/block and displacement loss. No friction retune.",
    "rotation": "Retain angular trajectories and left/right support. Scalar central bearing supplies no granular torque. Persistent asymmetric support without credible tilt is a distinct mechanism gap, never hidden by vertical tuning.",
