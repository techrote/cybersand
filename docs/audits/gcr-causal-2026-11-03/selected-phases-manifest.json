  "rounding": "floating fields formatted to6decimal places, integer counters unchanged; null remains explicit",
  "units": "Repository cell-coordinate units; angles radians, angular velocity radians/s, linear velocity cells/s, impulses mass*cells/s",
  "definitions": {
    "position_velocity": "row.position/velocity/rotation/omega at the producer-declared phase; barrel rows are post-bridge before the following Rapier step, flyer rows are post-Rapier",
    "nodes": "gcr.nodes",
    "eventJy": "gcr.event_accepted[1]",
    "passiveJy": "DERIVED: gcr.normal_impulse[1] + gcr.tangent_impulse[1], the accepted passive components; the raw schema has no passive_impulse key and passive_raw_impulse can precede an energy rejection",
    "deliveredJy": "application.bodies[0].impulse[1]",
    "actuatorJx": "controller.actual_impulse[0], direct backend actuation-stage measurement in these causal producers; barrel has no pilot actuation",
    "observedCorrectionY": "causal_phase.correction_setter.observed_translation[1]; for event barrel only, DERIVED actual post-bridge row.position[1] minus application.bodies[0].current_origin[1]",
    "effectiveCorrectionY": "DERIVED causal setter final_origin[1] minus pre_response_origin[1]; for event barrel only, same observed post-bridge translation because no setter follows bridge",
    "postOverlap": "barrel effective_overlap when present (stored cell centres at effective post-bridge/setter pose), otherwise row.post_overlap (flyer actual post-Rapier pose); these phases are not interchangeable efficacy metrics",
    "hardclear": "row.hard_clearance; false marks a hard-contact/proximity confound",
    "movementlimited": "controller.movement_limited, null when producer has no such rig (barrels)"
  },
