  },
  "reproduction": {
    "prepare": "python3 tools/wave_mt/ramp_profile.py prepare setup-water-ramp.json stamps.txt",
    "build": "make build/wave_waterwall",
    "ramp": "timeout 240 build/wave_waterwall ramp stamps=stamps.txt workers=6 ticks=1500 every=4 ramp_bank=1 ramp_shape=1 <shared and selected profile options>",
    "surge": "timeout 240 build/wave_waterwall <flat_surge|drop_surge|uphill_surge> workers=6 ticks=600 every=4 <shared and selected profile options>",
    "quiet": "timeout 120 build/wave_waterwall ramp stamps=stamps.txt workers=6 ticks=900 every=900 <shared and selected profile options>",
    "parity": "As ramp, with workers=1 and 6 independently for ticks=0 and 900, every=4. Compare every physical CSV field and the final World hashes.",
    "waterwall": "timeout 240 build/wave_waterwall map workers=6 terrain=terrain-wall.bin stamps=wall-stamps.txt probe0=440,540,192,102 source_box=440,540,192,102 stream_box=627,644,24,24 hydrograph=wall.csv ticks=1500 every=300 <shared and selected profile options>",
    "read_trace": "python3 tools/wave_mt/ramp_profile.py summarize <ramp or surge log...>"
  },
