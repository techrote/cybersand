  "style_guide": {
    "theme": "An eroded fossil coast after salt-winds, without industrial or neon instruments",
    "primary": "ChalkBlock 99 / LimestoneBlock 38 / SandstoneBlock 39",
    "secondary": "RockSaltBlock 106, Slate 49 and BasaltColumns 100 for age and shadow",
    "accents": "Brine 24 turquoise, Driftwood 88 grey, VerdigrisCopper 54 as very rare old marker; no glow",
    "composition": "2–3 low pale shelves per high silhouette; occasional spiral fossil and a single arch. One brine pan per ~400 cells maximum until cost measured",
    "ratio": "roughly 70% pale dry cliff, 20% dark cavity/strata, <=10% live material in mixed areas",
    "geometry": "tile-like orthogonal splines approximated with rectangles; no true sloped normals, physics surfaces remain cell-defined",
    "placement": "ground contact; no unsupported full-body physics claims; keep entrances empty and avoid crushing player clearance"
  },
