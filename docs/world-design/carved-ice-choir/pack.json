    "theme": "A blue-black naturally carved glacial cave shaped like an immense silent instrument",
    "primary": "BasaltColumns 100 / Slate 49 frame FrostedGlass 121 and QuartzCrystal 122",
    "secondary": "PackedSnow 105, thermally reactive Ice 9, GlassBlock 120",
    "accent": "optional Water 3 / Slush 21 reservoir and Dust 14 / Stone 13 falling notes",
    "rhythm": "one ceiling note for every two floor silhouettes, >=24 cells of negative space between long motifs",
    "ratio": "visual target 55% open cave air, 25% dark stone, 15% crystalline ice, <=5% mobile fill",
    "negative_space": "preserve empty cave void; never paint an Obsidian background behind playable space",
    "orientation": "no flips without rewriting anchor/collision rules"
