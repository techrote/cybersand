extends SceneTree

# Exercise the existing ordinary actor/equipment route while delaying only M4
# interval completion. No synthetic request, native World access or new device
# law is supplied by this test.
const Fixture = preload("res://tests/support/object_shard_m4_workbench_fixture.gd")
const Setup = preload("res://scripts/workbench_setup.gd")
const Session = preload("res://scripts/physical_actor_session.gd")
const Usables = preload("res://scripts/usable_catalog.gd")
var f: RefCounted
var evidence: Dictionary = {}

class DelayedEquipmentTransport extends "res://scripts/main.gd":
	# Delay delivery of one unchanged request generated by the real actor.
	# Every packet still contains actual Main-space poses and is admitted by
	# the unchanged worker API. No request or physics observation is invented.
	var delay_actor: int = -1
	var release_delayed: bool = false
	var capture_effects: bool = false
	var delayed_requests: Array = []
	var transport_records: Array = []
	func _publish_physical_body_state() -> void:
		if delay_actor<0 and not release_delayed and not capture_effects:
			super._publish_physical_body_state()
			return
		var sample: Dictionary = physical_actor_session.pack_workbench_sample()
		var delivered: Array = []
		for request: Dictionary in sample.get("equipment_requests",[]):
			if int(request.actor_id)==delay_actor: delayed_requests.append(request.duplicate(true))
			else: delivered.append(request)
		if release_delayed:
			delivered.append_array(delayed_requests)
			delayed_requests = []
			release_delayed = false
			delay_actor = -1
		sample.equipment_requests = delivered
		var admission: Dictionary = simulation_worker.set_workbench_sample(sample)
		if admission.get("accepted",false): _workbench_wait_sample = int(sample.states[10])
		if str(admission.get("status",""))=="refused":
			physical_actor_session.reject_equipment_requests(delivered,str(admission.get("reason","admission")))
		if not admission.get("accepted",false): _fault_workbench_frame(str(admission.get("reason","identity")))
		transport_records.append({"sample":int(sample.states[10]),"admission":admission,
			"delivered_request_ids":delivered.map(func(request: Dictionary) -> String: return str(request.request_id)),
			"held_request_ids":delayed_requests.map(func(request: Dictionary) -> String: return str(request.request_id)),
			"physical_effects":sample.get("physical_effects",[]).duplicate(true)})
		capture_effects = false

func _initialize() -> void:
	_run.call_deferred()

func _clocks() -> Dictionary:
	return {"native":int(f.host.simulation_worker.object_shard_owner_frame().get("tick",-1)),
		"actor":int(f.host.physical_actor_session.tick),
		"rapier":f.host.rapier_bridge.manual_step_count(),"material":int(f.runtime().physical_steps)}

func _copied_equipment() -> Dictionary:
	var snapshot: RefCounted = f.host.simulation_worker.take_latest_snapshot(0)
	return snapshot.physical_usables.duplicate(true) if snapshot != null else {}

func _receipt(request_id: String) -> Dictionary:
	for row: Dictionary in _copied_equipment().get("receipts",[]):
		if str(row.get("request_id",""))==request_id: return row.duplicate(true)
	return {}

func _copied_effects() -> Array:
	var snapshot: RefCounted = f.host.simulation_worker.take_latest_snapshot(0)
	return snapshot.physical_actor_effects.duplicate(true) if snapshot != null else []

func _pump_until(predicate: Callable, message: String) -> bool:
	var deadline: int = Time.get_ticks_msec()+15000
	while not predicate.call() and Time.get_ticks_msec()<deadline and f.runtime().held_reason.is_empty():
		f.runtime()._poll_once()
		if not predicate.call(): await process_frame
	return f.expect(bool(predicate.call()),message+" / "+str(f.diagnostics()))

func _begin_real_interval() -> bool:
	var deadline: int = Time.get_ticks_msec()+15000
	while int(f.runtime()._motion_lease)==0 and Time.get_ticks_msec()<deadline:
		f.host._process(0.0)
		f.host._physics_process(1.0/60.0)
		if int(f.runtime()._motion_lease)==0: await process_frame
	return f.expect(int(f.runtime()._motion_lease)>0,"actual worker grants the equipped interval a current native lease")

func _finish_segments() -> bool:
	return await _pump_until(func(): return f.runtime()._complete_requested and int(f.runtime()._pending_serial)==0,
		"four real segments finish and publish the actor's final equipment request")

func _complete_real_interval(before_tick: int) -> bool:
	f.runtime()._poll_once()
	return await _pump_until(func(): return int(f.runtime()._motion_lease)==0 and int(_clocks().native)==before_tick+1,
		"one completed physical interval authorizes its one native equipment/chemistry tick")

func _policy_action(instance: int, equipment_action: Dictionary) -> Dictionary:
	var view: Dictionary = f.bench.actor_observation(instance,true)
	if not f.expect(not view.is_empty(),"ordinary policy issues the current actor observation"): return {}
	var command: Dictionary = Session.make_command(view,int(view.last_sequence)+1,{"equipment":equipment_action},18)
	if not f.expect(f.bench.submit_actor_policy(instance,command),"fresh ordinary equipment input admitted through Workbench policy surface"): return {}
	return command

func _install_equipped_actor() -> bool:
	# One small authored setup avoids constructing and discarding a large
	# demonstration World merely to exercise this queue-ordering seam.
	set_meta("cybersand_feature","shared_workbench")
	f.host = load("res://main.tscn").instantiate()
	f.host.set_script(DelayedEquipmentTransport)
	root.add_child(f.host)
	process_frame.connect(f._observe_callback)
	if DisplayServer.get_name()!="headless": RenderingServer.frame_post_draw.connect(f._observe_draw)
	if not await f.until(f.installed,"ordinary Workbench installed for equipment completion"): return false
	f.bench = f.host.shared_workbench
	var recipe: Dictionary = Setup.fresh(PackedInt32Array(f.bench.applied.liquid_policy),Vector2i(512,512))
	recipe.edits = [[0,464,512,48,1],[0,0,3,512,1],[509,0,3,512,1],
		[180,440,8,8,7],[183,448,1,16,1]]
	var actor: Dictionary = Setup.instance("runner",1,Vector2(360,150))
	actor.control.source = "policy"
	actor.control.policy = "external"
	actor.control.usable_index = Usables.index_for(&"timer_airburst")
	var second: Dictionary = Setup.instance("runner",2,Vector2(420,150))
	second.control = actor.control.duplicate(true)
	var rocket: Dictionary = Setup.instance("rocketjumper",3,Vector2(100,451))
	rocket.control.source = "policy"
	rocket.control.policy = "external"
	recipe.actors = [actor,second,rocket]
	recipe.next_id = 4
	recipe.selected = 1
	if not f.expect(f.bench.apply(recipe),"ordinary authored runner and existing Timer Airburst equipment admitted"): return false
	if not await f.until(f.installed,"equipped authored World installed"): return false
	if not f.expect(f.bench.enable_object_shard(),"ordinary Structures controls enable the existing equipped canvas"): return false
	f.bench.set_camera(2)
	if not f.play(): return false
	if not await f.until(func(): return f.diagnostics().get("attached",false),
		"equipped ordinary owner attaches to the same native World and Main Rapier space"): return false
	if not await f.pause(): return false
	f.expect(f.body_count()==0,"complete ordinary stem anchors the authored Wood before erasure")
	f.bench._brush.value = 2
	for y: int in [450,454,458,461]:
		if not f.expect(f.bench.paint(Vector2i(183,y),0),"ordinary Erase removes the complete narrow support interval"): return false
		await process_frame
	if not await f.pause(): return false
	if not f.play(): return false
	if not await f.until(func(): return f.body_count()>0,"ordinary support cuts create an actual material body beside equipped actor"): return false
	return await f.pause()

func _run() -> void:
	f = Fixture.new(self)
	if not await _install_equipped_actor():
		await _finish(); return
	f.host.set_process(false)
	f.host.set_physics_process(false)
	if not f.play():
		await _finish(); return
	var view: Dictionary = f.bench.actor_observation(1,true)
	if not f.expect(not view.is_empty() and view.equipment.usable_id=="timer_airburst",
		"ordinary policy observation identifies the actual equipped actor"): await _finish(); return
	var command: Dictionary = _policy_action(1,{"trigger":true,"aim":Vector2.RIGHT,"power":0.75})
	var delayed_command: Dictionary = _policy_action(2,{"trigger":true,"aim":Vector2.RIGHT,"power":0.75})
	if command.is_empty() or delayed_command.is_empty():
		await _finish(); return
	f.host.delay_actor = 1
	var before: Dictionary = _clocks()
	if not await _begin_real_interval():
		await _finish(); return
	if not await _finish_segments():
		await _finish(); return
	var equipment: Dictionary = f.bench.actor_observation(1).equipment
	var request_id: String = str(equipment.get("request_id",""))
	if not f.expect(equipment.get("pending",false) and not request_id.is_empty(),
		"actual Main equipment owner generated one pending source-bound request / "+str(equipment)):
		await _finish(); return
	var held: Dictionary = _clocks()
	var lease: int = int(f.runtime()._motion_lease)
	var final_packet: Dictionary = f.host.transport_records.back().duplicate(true)
	var idle_before: int = int(f.host.simulation_worker.object_shard_owner_profile().segment_idle_polls)
	var publications: Dictionary = {}
	var deadline: int = Time.get_ticks_msec()+500
	while Time.get_ticks_msec()<deadline:
		var snapshot: RefCounted = f.host.simulation_worker.take_latest_snapshot(0)
		if snapshot != null: publications[int(snapshot.serial)] = true
		await process_frame
	var premature: Dictionary = _receipt(request_id)
	var delayed_state: Dictionary = _copied_equipment()
	var idle_after: int = int(f.host.simulation_worker.object_shard_owner_profile().segment_idle_polls)
	# Leased service deliberately retains the last coherent ordinary snapshot.
	# Prove actual asynchronous owner activity directly, rather than requiring
	# the redundant publications this path removes. The immutable transport
	# admission is the current queue witness; the retained display predates it.
	f.expect(publications.size()==1 and idle_after>idle_before,
		"the real asynchronous worker remains live without redundant ordinary publications while completion is withheld")
	f.expect(not f.host.paused and _clocks()==held and held.native==before.native \
		and held.actor==before.actor+1 and held.rapier==before.rapier+4 and held.material==before.material+4,
		"internal M4 wait advances no native or additional physical time while ordinary Play remains active")
	f.expect(final_packet.admission.get("accepted",false) and final_packet.admission.get("status")=="queued" \
		and final_packet.delivered_request_ids==[request_id] \
		and int(f.host.simulation_worker.object_shard_owner_profile().actor_work.pending_usables)==1,
		"real final Main packet admitted the ordinary equipment request")
	f.expect(premature.is_empty(),"internal motion lease retains the queued use without a premature suspended receipt")
	evidence.delayed = {"command":command,"request_id":request_id,"equipment":equipment,
		"before":before,"held":held,"lease":lease,"worker_publications":publications.size(),
		"worker_idle_polls":idle_after-idle_before,"final_packet":final_packet,
		"premature_receipt":premature,"worker_equipment":delayed_state}
	var later_id: String = str(f.bench.actor_observation(2).equipment.get("request_id",""))
	if not f.expect(f.host.delayed_requests.size()==1 and not later_id.is_empty() \
		and f.host.delayed_requests[0].request_id==later_id,
		"transport delay holds actor two's genuine unchanged request from the same actual interval"):
		await _finish(); return
	f.runtime()._poll_once() # Admit completion before delivering the second real request.
	f.host.release_delayed = true
	f.host._publish_physical_body_state()
	var later_delivery: Dictionary = f.host.transport_records.back().duplicate(true)
	f.expect(later_delivery.admission.get("accepted",false) and later_delivery.admission.get("queued",0)==1,
		"a newer actual Main packet admits the delayed equipment request after completion admission")
	if not await _pump_until(func(): return int(f.runtime()._motion_lease)==0 and int(_clocks().native)==int(before.native)+1,
		"one completed physical interval authorizes its one native equipment/chemistry tick"):
		await _finish(); return
	deadline = Time.get_ticks_msec()+1000
	while _receipt(request_id).is_empty() and Time.get_ticks_msec()<deadline: await process_frame
	var applied: Dictionary = _receipt(request_id)
	var completed: Dictionary = _copied_equipment()
	f.expect(applied.get("accepted",false) and applied.get("consumed",false) and applied.get("reason")=="launched",
		"the same genuine equipment request launches exactly once on its due native tick / "+str(applied))
	f.expect(completed.get("projectiles",[]).size()==1,
		"ordinary native equipment owns one actual launched payload")
	f.expect(f.runtime().last_receipt.get("captured_equipment_request_ids",[])==[request_id] \
		and _receipt(later_id).is_empty() \
		and int(f.host.simulation_worker.object_shard_owner_profile().get("actor_work",{}).get("pending_usables",-1))==1,
		"the earlier completion captures only its own request and retains the later delivery for its next interval")
	var retired: Dictionary = _clocks()
	for turn: int in range(16): await process_frame
	f.expect(_clocks()==retired and _copied_equipment().get("projectiles",[])==completed.get("projectiles",[]) \
		and _copied_equipment().get("tick")==completed.get("tick"),
		"further internal owner turns preserve exact projectile ages and equipment/native/physical clocks")
	evidence.completed = {"receipt":applied,"worker_equipment":completed,"clocks":retired,
		"completion_receipt":f.runtime().last_receipt.duplicate(true)}
	if not await _begin_real_interval() or not await _finish_segments() \
		or not await _complete_real_interval(int(retired.native)):
		await _finish(); return
	# Owner-frame tick publication precedes the ordinary snapshot carrying the
	# equipment receipt. Await that existing copied result without advancing
	# another physical interval or reading the worker-owned native object.
	deadline = Time.get_ticks_msec()+1000
	while _receipt(later_id).is_empty() and Time.get_ticks_msec()<deadline: await process_frame
	var later_applied: Dictionary = _receipt(later_id)
	f.expect(later_applied.get("accepted",false) and later_applied.get("reason")=="launched" \
		and f.runtime().last_receipt.get("captured_equipment_request_ids",[])==[later_id],
		"the delayed genuine request applies exactly on the next completed native interval")
	f.expect(_copied_equipment().get("projectiles",[]).size()==2,
		"two source-bound requests create exactly two actual native payloads across two intervals")
	evidence.cutoff = {"delayed_command":delayed_command,"later_delivery":later_delivery,
		"receipt":later_applied,"completion_receipt":f.runtime().last_receipt.duplicate(true),
		"transport":f.host.transport_records.duplicate(true),
		"scope":"only one genuine request's transport was delayed; packet poses and all physical/control ticks remain production; no assertion that the later packet won the worker scheduling race"}
	if not await _pause_cancels_queued_edge():
		await _finish(); return
	if not await _surface_blast_interval():
		await _finish(); return
	f.host.set_process(true)
	f.host.set_physics_process(true)
	await f.pause()
	await f.validate_quantity_ledger()
	await _finish()

func _pause_cancels_queued_edge() -> bool:
	# A new real alternate edge targets the already launched actor-one payload.
	# Pause must cancel it before completing this already advanced interval.
	var command: Dictionary = _policy_action(1,{"trigger":false,"alternate":true,"aim":Vector2.RIGHT,"power":0.75})
	if command.is_empty(): return false
	var before: Dictionary = _clocks()
	if not await _begin_real_interval() or not await _finish_segments(): return false
	var request_id: String = str(f.bench.actor_observation(1).equipment.get("request_id",""))
	if not f.expect(not request_id.is_empty() and _receipt(request_id).is_empty(),
		"a new actual alternate edge remains queued behind its live material lease"): return false
	var payloads: Array = _copied_equipment().get("projectiles",[]).duplicate(true)
	var equipment_tick: int = int(_copied_equipment().get("tick",-1))
	if not f.expect(f.bench.toggle_pause() and f.host.paused,"actual ordinary Pause cancels pending input immediately"): return false
	f.expect(int(f.host.simulation_worker.object_shard_owner_profile().get("actor_work",{}).get("pending_usables",-1))==0,
		"true user Pause clears the pending actor request through its existing cancellation authority")
	if not await _complete_real_interval(int(before.native)): return false
	var current: Dictionary = _copied_equipment()
	f.expect(_receipt(request_id).is_empty() and f.runtime().last_receipt.get("captured_equipment_request_ids",[]).is_empty(),
		"completing the physical interval does not resurrect the cancelled equipment edge")
	f.expect(current.get("projectiles",[])==payloads and int(current.get("tick",-1))==equipment_tick,
		"actual Pause preserves autonomous payload ages while the already admitted physical interval finishes")
	evidence.user_pause = {"command":command,"request_id":request_id,"before":before,"after":_clocks(),
		"completion_receipt":f.runtime().last_receipt.duplicate(true),"worker_equipment":current}
	return f.failures.is_empty()

func _surface_blast_interval() -> bool:
	# Rocketjumper's existing primary action performs its real Rapier surface
	# ray and emits the ordinary bounded effects packet. This exercises the
	# other nonempty queue pinned by completion, without fabricating a packet.
	if not f.play(): return false
	var view: Dictionary = f.bench.actor_observation(3,true)
	if not f.expect(not view.is_empty(),"ordinary policy observes the actual Rocketjumper beside the authored floor"): return false
	var command: Dictionary = Session.make_command(view,int(view.last_sequence)+1,
		{"primary":true,"aim":Vector2.DOWN,"effort":0.75},18)
	if not f.expect(f.bench.submit_actor_policy(3,command),"ordinary Rocketjumper surface-blast input is admitted"): return false
	f.host.capture_effects = true
	var before: Dictionary = _clocks()
	var previous_receipts: Array = _copied_effects()
	if not await _begin_real_interval() or not await _finish_segments(): return false
	var packet: Dictionary = f.host.transport_records.back().duplicate(true)
	var requests: Array = packet.get("physical_effects",[])
	var admission: Dictionary = f.host.simulation_worker.physical_actor_effect_admission()
	if not f.expect(requests.size()==1 and requests[0].kind=="blast" and requests[0].pattern=="rocket_charge" \
		and int(requests[0].actor_slot)==2 and int(admission.get("pending_requests",-1))==1,
		"real surface ray generated and admitted one source-bound Rocketjumper effect / "+str(packet)): return false
	var held: Dictionary = _clocks()
	var deadline: int = Time.get_ticks_msec()+250
	while Time.get_ticks_msec()<deadline: await process_frame
	f.expect(_clocks()==held and int(held.native)==int(before.native) and _copied_effects()==previous_receipts \
		and int(f.host.simulation_worker.physical_actor_effect_admission().get("pending_requests",-1))==1,
		"internal material lease retains the real actor effect without native writes or additional time")
	if not await _complete_real_interval(int(before.native)): return false
	deadline = Time.get_ticks_msec()+1000
	while _copied_effects()==previous_receipts and Time.get_ticks_msec()<deadline: await process_frame
	var receipts: Array = _copied_effects()
	if not f.expect(receipts.size()==1 and int(receipts[0].actor_slot)==int(requests[0].actor_slot) \
		and int(receipts[0].epoch)==int(requests[0].epoch) and int(receipts[0].sequence)==int(requests[0].sequence) \
		and receipts[0].get("consumed",false) and receipts[0].get("status")=="applied" \
		and int(receipts[0].get("changed_cells",0))>0,
		"the same actual surface-blast request changes native cells on its one due tick / "+str(receipts)): return false
	f.expect(int(f.runtime().last_receipt.get("captured_effect_count",-1))==1 \
		and int(f.host.simulation_worker.physical_actor_effect_admission().get("pending_requests",-1))==0,
		"one completed material interval consumes its exact nonempty effects envelope")
	var completion: Dictionary = f.runtime().last_receipt.duplicate(true)
	var applied: Dictionary = _clocks()
	view = f.bench.actor_observation(3,true)
	var neutral: Dictionary = Session.make_command(view,int(view.last_sequence)+1,{"primary":false,"aim":Vector2.DOWN},18)
	if not f.expect(f.bench.submit_actor_policy(3,neutral),"ordinary neutral input releases the actual blast edge"): return false
	if not await _begin_real_interval() or not await _finish_segments() \
		or not await _complete_real_interval(int(applied.native)): return false
	f.expect(int(f.runtime().last_receipt.get("captured_effect_count",-1))==0 \
		and _copied_effects()==receipts \
		and int(f.host.simulation_worker.physical_actor_effect_admission().get("accepted_requests",-1))==int(admission.accepted_requests),
		"the next real interval admits no duplicate effect and preserves its single application receipt")
	evidence.surface_blast = {"command":command,"packet":packet,"admission":admission,
		"receipts":receipts,"completion_receipt":completion,"following_completion":f.runtime().last_receipt.duplicate(true),
		"before":before,"held":held,"applied":applied,"after":_clocks()}
	return f.failures.is_empty()

func _finish() -> void:
	if f.host != null:
		f.host.set_process(true)
		f.host.set_physics_process(true)
		f.validate_display()
		evidence.display = f.display_witness()
	evidence.inventory_witnesses = f.inventory_witnesses
	await f.close()
	print(JSON.stringify({"schema":"objectshard-m4-equipment-completion-v1",
		"source_commit":OS.get_environment("CYBERSAND_SOURCE_REVISION"),
		"checks":f.checks,"failures":f.failures,"evidence":evidence}))
	quit(0 if f.failures.is_empty() else 1)
