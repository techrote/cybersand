extends "res://tests/test_architectural_generator.gd"

# Exercise the ordinary selector, preview, confirmed World install, material
# editing and saved-start reconstruction. Author and reopen run in separate
# OS processes. This suite never changes Workbench/actor/presentation source.
var capture_this_style := false
var completed_styles := 0
var catalogue_size := 0

func framebuffer(label: String, popup: Window = null) -> void:
	if capture_this_style: await super.framebuffer(label, popup)

func _selected_project() -> Dictionary:
	var value: Dictionary = Project.default_project()
	value.extent = [512, 512]
	value.origin = [0, 0]
	value.zone_scale = 64
	value.seed = 605
	value.automatic_tunnels = false
	value.automatic_windows = true
	value.styles = [{"enabled": true, "share": 100.0, "preset": Project.builtin_presets()[0].duplicate(true)}]
	return value

func _select_builtin(panel: ConfirmationDialog, catalogue_index: int) -> bool:
	var chooser: OptionButton = panel._style_controls[0].chooser
	for item: int in chooser.item_count:
		if chooser.get_item_id(item) == catalogue_index:
			chooser.select(item)
			chooser.item_selected.emit(item)
			return true
	return check(false, "requested catalogue identity reachable from ordinary dropdown")

func _catalogue_search(panel: ConfirmationDialog) -> void:
	var controls: Dictionary = panel._style_controls[0]
	var before: Dictionary = panel.project()
	controls.search.text = "interlaced"
	controls.search.text_changed.emit(controls.search.text)
	check(controls.chooser.item_count == 2, "search keeps current style and the single matching Interlaced style")
	check(panel.project() == before, "search does not mutate geometry, material choices or current selection")
	var index := -1
	var presets: Array = Project.builtin_presets()
	for i: int in presets.size():
		if presets[i].id == "interlaced-viaduct": index = i
	if check(index >= 0, "Interlaced catalogue identity exists"):
		_select_builtin(panel, index)
		check(panel.project().styles[0].preset.id == "interlaced-viaduct", "filtered index resolves stable builtin identity")
	controls.search.text = "no-style-with-this-name"
	controls.search.text_changed.emit(controls.search.text)
	check(controls.chooser.item_count == 1 and panel.project().styles[0].preset.id == "interlaced-viaduct", "no matches retains the chosen style without silently replacing it")
	controls.search.text = ""
	controls.search.text_changed.emit("")
	check(controls.chooser.item_count == 93, "clearing search restores all 80 Genteks and 13 accepted presets")

func _install(packet: Dictionary, label: String) -> bool:
	var previous: int = int(host.latest_snapshot.render_world_generation)
	dialog.confirmed.emit()
	dialog.hide()
	if not await until(func() -> bool: return installed() and str(wb._generated_active.get("sha256", "")) == str(packet.sha256), label + " installed"): return false
	check(int(host.latest_snapshot.render_world_generation) > previous, label + " fresh native World acknowledgement")
	check(host.tower_context.get("liquid_construction_receipt", {}).get("generated_source_sha256", "") == packet.sha256, label + " actual constructor attests generated bytes")
	return true

func _edit_and_save(identity: String, packet: Dictionary) -> bool:
	wb._brush.value = 1
	if not check(wb.paint(Vector2i(101, 99), 58), identity + " ordinary paint accepted"): return false
	if not await until(func() -> bool: return host.image.get_width() == 512 and host.image.get_pixel(101, 99).r8 == 58, identity + " paint visible in native snapshot"): return false
	if not check(wb.paint(Vector2i(111, 99), 0), identity + " ordinary erase accepted"): return false
	if not await until(func() -> bool: return host.image.get_pixel(111, 99).r8 == 0 and paint_completed(), identity + " erase and edit acknowledgement"): return false
	wb._name.text = "gentek80-" + identity
	if not check(wb.save_setup(), identity + " generated start saved"): return false
	var saved: Dictionary = Store.read_named(wb._name.text)
	check(saved.get("generated", false) and saved.setup.edits.size() >= 2, identity + " recipe and ordered edits persisted")
	check(saved.generation.recipe_sha256 == packet.recipe_sha256, identity + " saved recipe identity")
	var tick: int = int(host.latest_snapshot.tick_index)
	if not check(wb.step_once(), identity + " ordinary material simulation step accepted"): return false
	if not await until(func() -> bool: return not wb.step_pending and int(host.latest_snapshot.tick_index) == tick + 1, identity + " actual single native tick completes"): return false
	return true

func _campaign(reopening: bool) -> void:
	if OS.get_environment("CYBERSAND_ARCHITECTURE_REQUIRE_GRAPHICS") == "1":
		if not check(DisplayServer.get_name() != "headless", "actual graphical display required"): return
	root.size = Vector2i(1600, 1000)
	change_scene_to_file("res://feature_launcher.tscn")
	await scene_changed
	current_scene.launch("shared_workbench")
	await scene_changed
	host = current_scene
	wb = host.shared_workbench
	dialog = wb._generated_dialog
	preview_clock = PreviewClock.new()
	preview_clock.dialog = dialog
	root.add_child(preview_clock)
	if not await until(installed, "ordinary Shared Workbench ready"): return
	var presets: Array = Project.builtin_presets()
	catalogue_size = presets.size()
	check(catalogue_size == 93, "exactly 80 Genteks plus 13 existing presets")
	var limit := int(OS.get_environment("CYBERSAND_GENTEK80_WB_LIMIT"))
	var selected: Array[int] = []
	for index: int in range(13, presets.size()): selected.append(index)
	if limit > 0: selected = selected.slice(0, limit)
	if not reopening:
		dialog.open_new()
		dialog._architecture_button.pressed.emit()
		var form: ConfirmationDialog = dialog._architecture
		check(form.set_project(_selected_project()), "ordinary form accepts single-style controls")
		_catalogue_search(form)
		capture_this_style = true
		await framebuffer("gentek80-search-and-selection", form)
		form.hide()
	for index: int in selected:
		var preset: Dictionary = presets[index]
		var identity: String = preset.id
		capture_this_style = index in [13, 18, 20] or index >= 85
		var started := Time.get_ticks_usec()
		var saved := {}
		if reopening:
			wb._name.text = "gentek80-" + identity
			saved = Store.read_named(wb._name.text)
			if not check(saved.get("generated", false), identity + " saved start exists in independent process"): return
			preview_clock.begin()
			if not check(wb.load_setup(), identity + " ordinary Load start begins"): return
		else:
			dialog.open_new()
			dialog._architecture_button.pressed.emit()
			var panel: ConfirmationDialog = dialog._architecture
			if not check(panel.set_project(_selected_project()), identity + " form initialized"): return
			if not _select_builtin(panel, index): return
			check(panel.project().styles[0].preset == preset, identity + " selected complete ordinary preset")
			preview_clock.begin()
			panel._apply()
		if not await preview_ready("gentek80-" + identity + ("-reopen" if reopening else "-preview")): return
		var packet: Dictionary = dialog._ready_packet.duplicate(true)
		if not check(packet.cells.size() == 512 * 512, identity + " complete native material payload"): return
		if not reopening and (index in [18, 20] or index >= 85):
			var original: String = packet.sha256
			var modified: Dictionary = dialog._architecture_project.duplicate(true)
			modified.seed = 1701
			preview_clock.begin()
			if not check(dialog.start_architectural(modified), identity + " repeated reseeding"): return
			if not await preview_ready("gentek80-" + identity + "-reseed"): return
			modified.seed = 605
			preview_clock.begin()
			if not check(dialog.start_architectural(modified), identity + " return to original seed"): return
			if not await preview_ready("gentek80-" + identity + "-replay"): return
			packet = dialog._ready_packet.duplicate(true)
			check(packet.sha256 == original, identity + " deterministic same-seed UI replay")
		if not await _install(packet, identity): return
		if reopening:
			check(wb.applied.edits == saved.setup.edits and packet.recipe_sha256 == saved.generation.recipe_sha256, identity + " independent process restores exact recipe and edits")
			if not await until(func() -> bool: return host.image.get_width() == 512 and host.image.get_pixel(101, 99).r8 == 58 and host.image.get_pixel(111, 99).r8 == 0, identity + " saved material edits restored by actual World"): return
		else:
			if not await _edit_and_save(identity, packet): return
		await framebuffer("gentek80-" + identity + ("-restored-world" if reopening else "-edited-world"))
		completed_styles += 1
		report.cases.append({"case": "gentek80-reopen" if reopening else "gentek80-author", "preset_id": identity, "module": preset.module, "source_sha256": packet.sha256, "recipe_sha256": packet.recipe_sha256, "elapsed_us": Time.get_ticks_usec() - started, "display": DisplayServer.get_name()})
		print("GENTEK80_WORKBENCH_PROGRESS ", completed_styles, "/", selected.size(), " ", identity)
	complete = completed_styles == selected.size() and (limit > 0 or completed_styles == 80)

func run() -> void:
	var phase := OS.get_environment("CYBERSAND_GENTEK80_WB_PHASE")
	if phase.is_empty(): phase = "author"
	var began := Time.get_ticks_usec()
	report.merge({"phase": phase, "godot": Engine.get_version_info().string, "os": OS.get_name(), "display": DisplayServer.get_name()})
	if check(phase in ["author", "reopen"], "known Workbench campaign phase") and check(ClassDB.class_exists(&"CyberWorldGenerator"), "source-built native generator available"):
		await _campaign(phase == "reopen")
	check(complete, "mandatory complete Workbench campaign")
	report.merge({"schema": "gentek80-workbench-phase-v1", "checks": checks, "failures": failures, "complete": complete, "completed": complete, "process_id": OS.get_process_id(), "catalogue_ids": Project.builtin_presets().slice(13).map(func(p: Dictionary) -> String: return str(p.id)), "styles": completed_styles, "catalogue_choices": catalogue_size, "elapsed_us": Time.get_ticks_usec() - began, "source_commit": OS.get_environment("CYBERSAND_SOURCE_REVISION")})
	write_json("gentek80-workbench-" + phase + ".json", report)
	if host != null:
		preview_clock.queue_free()
		host.queue_free()
		await process_frame
		await process_frame
	print("GENTEK80_WORKBENCH phase=", phase, " styles=", completed_styles, " checks=", checks, " failures=", failures, " complete=", complete)
	quit(1 if failures else 0)
