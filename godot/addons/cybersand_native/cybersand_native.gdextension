[configuration]

entry_symbol = "cybersand_native_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://addons/cybersand_native/bin/libcybersand_native.linux.x86_64.so"
linux.release.x86_64 = "res://addons/cybersand_native/bin/libcybersand_native.linux.x86_64.so"
windows.debug.x86_64 = "res://addons/cybersand_native/bin/cybersand_native.windows.x86_64.dll"
windows.release.x86_64 = "res://addons/cybersand_native/bin/cybersand_native.windows.x86_64.dll"
